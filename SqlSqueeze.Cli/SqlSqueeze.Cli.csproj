<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SqlSqueeze.Cli</RootNamespace>
    <AssemblyName>sqlsqueeze</AssemblyName>
    <Version>1.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlSqueeze.Core\SqlSqueeze.Core.csproj" />
    <ProjectReference Include="..\SqlSqueeze.Plugins\SqlSqueeze.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="COPYING.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
