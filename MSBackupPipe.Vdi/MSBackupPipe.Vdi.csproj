<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VdiNet.VirtualBackupDevice</AssemblyName>
    <RootNamespace>VdiNet.VirtualBackupDevice</RootNamespace>
    <Version>1.3.0</Version>
    <Description>C# interop for the SQL Server Virtual Backup Device Interface (VDI). Replaces the original C++/CLI wrapper and the VDI.Net binary dependency.</Description>
  </PropertyGroup>

</Project>
